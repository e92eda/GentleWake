[Unit]
Description=GentleWake alarm/sensor web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kunieda
WorkingDirectory=/home/kunieda/GentleWake
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/kunieda/GentleWake/.venv/bin/python /home/kunieda/GentleWake/web.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
